{
  "name": "openclaw-team-manager",
  "version": "0.1.1",
  "description": "Multi-Agent Collaboration Framework - CLI Management Tool (Basic Version: Agent Creation + Feishu Binding)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "openclaw-team-manager": "./dist/bin/team-manager.js",
    "openclaw-team-setup": "./dist/bin/team-setup.js",
    "openclaw-team-uninstall": "./dist/bin/team-uninstall.js"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"require('fs').copyFileSync('src/db/schema.sql', 'dist/db/schema.sql')\"",
    "start": "node dist/bin/team-manager.js",
    "dev": "ts-node src/bin/team-manager.ts",
    "uninstall": "node dist/bin/team-uninstall.js",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "agent",
    "collaboration",
    "openclaw",
    "cli",
    "multi-agent",
    "feishu",
    "lark",
    "assistant",
    "automation",
    "team"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/poderosom1/openclaw-team-manager.git"
  },
  "bugs": {
    "url": "https://github.com/poderosom1/openclaw-team-manager/issues"
  },
  "homepage": "https://github.com/poderosom1/openclaw-team-manager#readme",
  "files": [
    "dist/**/*",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "handlebars": "^4.7.8",
    "inquirer": "^8.2.6",
    "ora": "^5.4.1",
    "uuid": "^9.0.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ]
}
